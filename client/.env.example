# Copy to client/.env only if you need it. Locally you do not: leaving
# VITE_API_URL unset makes the app use relative paths, which the Vite dev proxy
# forwards to the server on port 5000.
#
# In production the API is on Render, a different origin, so Vercel needs this
# set in its environment panel. No trailing slash.
#
# Anything here is compiled into the bundle and readable by anyone, so never
# put a secret in this file.
VITE_API_URL=https://your-api.onrender.com
