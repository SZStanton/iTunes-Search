# Copy to server/.env and fill in. The server will not start without
# MONGODB_URI. The rest have fallbacks, but never deploy on those.

# Atlas connection string. The database name goes between the host and the '?',
# or mongoose quietly uses one called 'test'.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/itunes-search?retryWrites=true&w=majority

# Signs the token people get when they log in.
# Use a different value here from the one in production.
JWT_SECRET=change-me

# Port the API listens on. The Vite dev proxy expects 5000.
PORT=5000

# The only origin allowed to call the API.
CLIENT_URL=http://localhost:5173

# Optional. The shared account a visitor can try without registering. Set both,
# then run "npm run seed:demo". Rerun it if the database is ever cleared.
# Accounts here are email and password only, so this is an email, not a handle.
DEMO_EMAIL=demo@itunes-search.test
DEMO_PASSWORD=