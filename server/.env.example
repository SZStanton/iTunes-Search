# Copy to server/.env and fill in. The app runs without it, on the fallbacks
# below, but never deploy on those.

# Signs the token the frontend gets before it can search.
# Use a different value here from the one in production.
JWT_SECRET=change-me

# The only origin allowed to call the API.
CLIENT_URL=http://localhost:5173

# Port the API listens on. The Vite dev proxy expects 5000.
PORT=5000
